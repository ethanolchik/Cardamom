public class Person(private name: string, private age: int) {
    private address: string = "1 High Road";

    public test: string = "hello";

    public static hello: string = "Hello";
    private static instances: int = 0;

    public getAddress() -> string {
        return this.address;
    }

    public birthday() -> int {
        this.age += 1;

        return this.age;
    }

    public getName() -> string {
        return this.name;
    }
}

fn test<T>(x: T) -> T {
    return x;
}

fn test2() {
    return;
}

fn main() {
    let p: Person = new Person("Ethan", 18);

    // Pointer Arithmetic

    let x: int = 1;

    let z: &int[] = &[1, 2, 3];

    let a: int[] = [1, 2, 3];

    let b: (fn(int) -> int)[] = [];

    let increment: fn(&mut int) -> void = |x| void -> { x += 1; };
    
    let closure_ret_closure: fn() -> fn(&mut int) -> void = || fn(&mut int) -> void -> { return increment; };

    let n: int = 1;
    closure_ret_closure()(n);

    test<float>(1.1);
}
