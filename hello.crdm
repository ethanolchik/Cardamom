import io;
import str;

fn fizzbuzz(n: int) {
    for (let i: int = 0; i <= n; i+=1) {
        if ((i % 3 == 0) && (i % 5 == 0)) {
            io.println("FizzBuzz");
        } else if (i % 3 == 0) {
            io.println("Fizz");
        } else if (i % 5 == 0) {
            io.println("Buzz");
        } else {
            io.println(str.fromInt(i));
        }
    }
}

fn main() {
    fizzbuzz(20);
}
