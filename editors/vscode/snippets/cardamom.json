{
  "Main function": {
    "prefix": "main",
    "body": [
      "fn main() {",
      "    $0",
      "}"
    ],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:parameters}) -> ${3:void} {",
      "    $0",
      "}"
    ],
    "description": "Function declaration"
  },
  "Generic function": {
    "prefix": "fn-generic",
    "body": [
      "fn ${1:identity}<${2:T}>(${3:value}: ${2:T}) -> ${2:T} {",
      "    return ${3:value};",
      "}"
    ],
    "description": "Generic function with an inferred type argument"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "public class ${1:Name}(private ${2:value}: ${3:int}) {",
      "    public ${4:get}() -> ${3:int} {",
      "        return this.${2:value};",
      "    }",
      "}"
    ],
    "description": "Class with a constructor field and a method"
  },
  "Import": {
    "prefix": "import",
    "body": "import ${1:io};",
    "description": "Import a Cardamom module"
  },
  "C++ intrinsic": {
    "prefix": "cpp",
    "body": "@cpp(\"${1:return 0;}\");",
    "description": "Embed a C++ statement"
  },
  "Header intrinsic": {
    "prefix": "include",
    "body": "@include(\"<${1:cmath}>\");",
    "description": "Include a native header"
  }
}
