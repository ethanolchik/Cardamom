fn main() {
    // The closure body does not match the declared parameter type.
    let increment: fn(&mut string) -> void = |x| void -> { x += 1; };

    let closure_ret_closure: fn() -> fn(&mut int) -> void = || fn(&mut int) -> void -> { return increment; };

    let n: int = 1;
    closure_ret_closure()(n);
}
