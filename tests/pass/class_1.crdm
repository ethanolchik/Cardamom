import io;
import str;

public class Person(private name: string, private age: int) {
    private address: string = "1 High Road";
    public static species: string = "human";
    private static counter: int = 0;

    public getName() -> string {
        return this.name;
    }

    public getAddress() -> string {
        return this.address;
    }

    public birthday() -> int {
        this.age += 1;
        return this.age;
    }
}

fn main() {
    let p: Person = new Person("Ethan", 17);

    io.println(p.getName());
    io.println(p.getAddress());
    io.println(str.fromInt(p.birthday()));
}
