fn copy(source: &int[], destination: &mut int[]) {
    destination = source;
    destination[0] += 10;
}

fn main() -> int {
    let source: int[] = [1, 2];
    let destination: int[] = [];
    copy(source, destination);
    if (source[0] != 1 || destination[0] != 11 || destination[1] != 2) {
        return 1;
    }
    return 0;
}
