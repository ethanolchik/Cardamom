import raylib as gfx;
import flock;
import timeline;
import arrangement;
import composer;
import music;
import forkview as view;
import forksmoke;
import runtime;
import str;
import math;

fn emptyNotes() -> float[][] {
    let notes: float[][] = [];
    let empty: float[] = [];
    let i: int = 0;
    while (i < 6) { notes.push(empty); i += 1; }
    return notes;
}

fn main() -> int {
    let width: float = view.worldWidth();
    let height: float = view.worldHeight();
    let seed: int = 42;
    let initial: float[] = flock.create(144, width, height, seed);
    let worlds: float[][][] = timeline.history(initial);
    let parts: int[][] = timeline.parts();
    let meta: int[] = timeline.metadata(1801);
    let rules: float[][] = timeline.laws();
    let mix: float[][] = arrangement.settings();
    let clock: int[] = [120, 2, 0, 1];
    let scene: int = arrangement.sceneId(runtime.env("CARDAMOM_FORKS_SCENE"));
    arrangement.start(scene, initial, width, worlds, parts, meta, rules, mix, clock);
    let selected: int = 0;
    let pending: float[] = rules[0];
    let recent: float[][] = emptyNotes();
    let paused: int = 0;
    let ghost: int = 1;
    let soundOn: int = 1;
    let volume: float = 0.7;
    // -1 none; 0 timeline; 1-3 laws; 4 master; 5 density; 6 level; 7 pan.
    let dragging: int = -1;
    let accumulator: float = 0.0;
    let frame: int = 0;
    let frameLimit: int = 0;
    let frameSetting: string = runtime.env("CARDAMOM_FORKS_FRAMES");
    if (str.len(frameSetting) > 0) { frameLimit = str.toInt(frameSetting); }
    let screenshot: string = runtime.env("CARDAMOM_FORKS_SCREENSHOT");
    if (str.len(screenshot) == 0) { screenshot = "forks.png"; }
    gfx.enableAntialiasing();
    gfx.initWindow(1424, 944, "Cardamom | Flock ensemble");
    if (!gfx.isWindowReady()) { return 1; }
    gfx.setTargetFPS(60);
    let bank: int[][] = [];
    if (runtime.env("CARDAMOM_FORKS_SILENT") != "1") { bank = music.open(); }
    gfx.setMasterVolume(volume);

    while (!gfx.windowShouldClose()) {
        if (frameLimit > 0) { forksmoke.input(frame); }
        let mx: float = gfx.getMouseX();
        let my: float = gfx.getMouseY();
        let clicked: int = gfx.isMouseButtonPressed(0);
        let down: int = gfx.isMouseButtonDown(0);
        if (!down) { dragging = -1; }
        let cutAll: int = 0;
        let cutPart: int = -1;
        let remixPart: int = -1;
        let routeChanged: int = 0;
        let wantsFork: int = gfx.isKeyPressed(70);
        let forkSlot: int = -1;
        let nextScene: int = -1;
        let slot: int = 0;

        while (slot < 6) {
            if (parts[slot][2] && gfx.isKeyPressed(49 + slot) && selected != slot) {
                selected = slot; pending = rules[selected]; dragging = -1;
            }
            slot += 1;
        }
        if (clicked) {
            let picked: int = view.pickPart(mx, my);
            if (picked >= 0) {
                if (!parts[picked][2]) { wantsFork = 1; forkSlot = picked; }
                else {
                    if (picked != selected) { selected = picked; pending = rules[selected]; dragging = -1; }
                    if (view.inside(mx, my, view.cardX(picked) + 12, view.cardY(picked) + 236, 60, 26)) {
                        mix[picked][6] = 1.0 - mix[picked][6]; routeChanged = 1;
                    }
                    if (view.inside(mx, my, view.cardX(picked) + 78, view.cardY(picked) + 236, 56, 26)) {
                        mix[picked][7] = 1.0 - mix[picked][7]; routeChanged = 1;
                    }
                }
            }
        }
        if (selected > 0 && (gfx.isKeyPressed(261) || (clicked && view.inside(mx, my, 1302, 139, 82, 28)))) {
            music.resetPart(bank, selected);
            timeline.remove(worlds, parts, selected);
            selected = 0; pending = rules[0]; scene = -1; cutAll = 1; dragging = -1;
        }
        if (gfx.isKeyPressed(77) || (clicked && view.inside(mx, my, 384, 28, 108, 30))) {
            soundOn = 1 - soundOn;
            if (!soundOn) { cutAll = 1; }
        }
        if (gfx.isKeyPressed(71) || (clicked && view.inside(mx, my, 882, 868, 142, 30))) { ghost = 1 - ghost; }
        if (gfx.isKeyPressed(82) || (clicked && view.inside(mx, my, 718, 868, 148, 30))) {
            seed += 97; initial = flock.create(144, width, height, seed);
            timeline.restart(worlds, parts, meta, rules, initial, width);
            paused = 0; accumulator = 0.0; dragging = -1; cutAll = 1;
        }
        slot = 0;
        while (slot < 3) {
            if (clicked && view.inside(mx, my, 24 + slot * 228, 868, 218, 30)) { nextScene = slot; }
            slot += 1;
        }

        if (clicked && view.inside(mx, my, 512, 28, 26, 30)) { clock[0] = math.max(60, clock[0] - 5); cutAll = 1; scene = -1; }
        if (clicked && view.inside(mx, my, 638, 28, 26, 30)) { clock[0] = math.min(180, clock[0] + 5); cutAll = 1; scene = -1; }
        if (clicked && view.inside(mx, my, 684, 28, 82, 30)) { clock[1] = (clock[1] + 1) % 12; cutAll = 1; scene = -1; }
        if (clicked && view.inside(mx, my, 784, 28, 224, 30)) { clock[2] = (clock[2] + 1) % 4; cutAll = 1; scene = -1; }
        if (clicked && view.inside(mx, my, 684, 74, 164, 26)) { clock[3] = 1 - clock[3]; cutAll = 1; scene = -1; }
        slot = 0;
        while (slot < 6) {
            if (clicked && view.inside(mx, my, 1068 + slot % 3 * 108, 196 + slot / 3 * 34, 100, 28) &&
                (as int mix[selected][0]) != slot) {
                mix[selected][0] = as float slot; cutPart = selected; scene = -1;
            }
            slot += 1;
        }
        if (clicked && view.inside(mx, my, 1068, 288, 316, 30)) {
            mix[selected][1] = as float (((as int mix[selected][1]) + 1) % 6); cutPart = selected; scene = -1;
        }
        if (clicked && view.inside(mx, my, 1068, 352, 150, 28)) {
            mix[selected][3] += 1.0;
            if (mix[selected][3] > 1.0) { mix[selected][3] = -1.0; }
            cutPart = selected; scene = -1;
        }
        if (clicked && view.inside(mx, my, 1230, 352, 154, 28)) {
            mix[selected][9] += 4.0;
            if (mix[selected][9] > 16.0) { mix[selected][9] = 8.0; }
            mix[selected][2] = flock.clamp(mix[selected][2], 1.0, mix[selected][9]);
            cutPart = selected; scene = -1;
        }
        slot = 0;
        while (slot < 3) {
            if (clicked && view.inside(mx, my, 1068 + slot * 108, 410, 100, 28) &&
                (as int mix[selected][8]) != slot) {
                mix[selected][8] = as float slot; cutPart = selected; scene = -1;
            }
            if (clicked && view.inside(mx, my, 1064 + slot * 108, 704, 108, 28)) { dragging = slot + 1; }
            slot += 1;
        }
        if (clicked && view.inside(mx, my, 1068, 748, 140, 28)) { pending[3] = 1.0 - pending[3]; }
        if (clicked && view.inside(mx, my, 1068, 790, 316, 40)) { wantsFork = 1; }
        if (clicked && view.inside(mx, my, 436, 73, 164, 24)) { dragging = 4; }
        if (clicked && view.inside(mx, my, 1064, 474, 320, 24)) { dragging = 5; }
        if (clicked && view.inside(mx, my, 1064, 530, 320, 24)) { dragging = 6; }
        if (clicked && view.inside(mx, my, 1064, 588, 320, 24)) { dragging = 7; }

        if (gfx.isKeyPressed(32) || (clicked && view.inside(mx, my, 24, 752, 82, 32))) {
            paused = 1 - paused; accumulator = 0.0; cutAll = 1;
        }
        let stride: int = 1;
        if (gfx.isKeyDown(340) || gfx.isKeyDown(344)) { stride = 60; }
        if (gfx.isKeyPressed(263) || (clicked && view.inside(mx, my, 116, 752, 32, 32))) {
            timeline.seek(worlds, parts, meta, rules, timeline.playhead(meta) - stride, width, height);
            paused = 1; accumulator = 0.0; cutAll = 1;
        }
        if (gfx.isKeyPressed(262) || (clicked && view.inside(mx, my, 156, 752, 32, 32))) {
            let step: int = 0;
            while (step < stride) { timeline.advance(worlds, parts, meta, rules, width, height); step += 1; }
            paused = 1; accumulator = 0.0; cutAll = 1;
        }
        if (gfx.isKeyPressed(268)) {
            timeline.seek(worlds, parts, meta, rules, timeline.oldest(meta), width, height);
            paused = 1; accumulator = 0.0; cutAll = 1;
        }
        if (gfx.isKeyPressed(269) || (clicked && view.inside(mx, my, 936, 752, 88, 32))) {
            timeline.seek(worlds, parts, meta, rules, timeline.newest(meta), width, height);
            paused = 0; accumulator = 0.0; cutAll = 1;
        }
        if (clicked && view.inside(mx, my, 202, 748, 728, 39)) { dragging = 0; }
        if (dragging == 0) {
            timeline.seek(worlds, parts, meta, rules, view.trackTick(meta, mx), width, height);
            paused = 1; accumulator = 0.0; cutAll = 1;
        } else if (dragging > 0 && dragging < 4) {
            let x: float = 1068.0 + (as float (dragging - 1)) * 108.0;
            let value: float = flock.clamp((mx - x) / 100.0 * 3.0, 0.0, 3.0);
            pending[dragging - 1] = (as float (as int (value * 10.0 + 0.5))) / 10.0;
        } else if (dragging == 4) {
            volume = flock.clamp((mx - 444.0) / 148.0, 0.0, 1.0);
            gfx.setMasterVolume(volume);
        } else if (dragging == 5) {
            let value: float = flock.clamp((mx - 1072.0) / 304.0, 0.0, 1.0);
            mix[selected][2] = as float (as int (1.0 + value * (mix[selected][9] - 1.0) + 0.5));
            cutPart = selected; scene = -1;
        } else if (dragging == 6) {
            mix[selected][4] = flock.clamp((mx - 1072.0) / 304.0, 0.0, 1.0);
            remixPart = selected; scene = -1;
        } else if (dragging == 7) {
            mix[selected][5] = flock.clamp((mx - 1072.0) / 304.0, 0.0, 1.0);
            remixPart = selected; scene = -1;
        }

        if (nextScene >= 0) {
            scene = nextScene;
            arrangement.start(scene, initial, width, worlds, parts, meta, rules, mix, clock);
            selected = 0; pending = rules[0]; paused = 0; accumulator = 0.0; dragging = -1; cutAll = 1;
            slot = 0;
            while (slot < 6) { music.resetPart(bank, slot); slot += 1; }
        }
        if (wantsFork) {
            let instrument: int = arrangement.unusedInstrument(parts, mix);
            if (forkSlot < 0) { forkSlot = timeline.available(parts); }
            let created: int = timeline.forkAt(worlds, parts, meta, rules, selected, forkSlot, pending, width);
            if (created >= 0) {
                music.resetPart(bank, created);
                mix[created] = arrangement.defaults(instrument, created);
                selected = created; pending = rules[created]; scene = -1;
                paused = 0; accumulator = 0.0; dragging = -1; cutAll = 1;
            }
        }
        if (cutAll) { music.silence(bank); recent = emptyNotes(); }
        else if (cutPart >= 0) {
            music.silencePart(bank, cutPart);
            let empty: float[] = []; recent[cutPart] = empty;
        }
        if (remixPart >= 0) { music.remix(bank, remixPart, mix[remixPart]); }
        if (routeChanged) { music.route(bank, parts, mix, timeline.playhead(meta)); }

        if (!paused) {
            let elapsed: float = flock.clamp(gfx.getFrameTime(), 0.0, 0.05);
            if (frameLimit > 0) { elapsed = 0.016666667; }
            accumulator += elapsed;
            while (accumulator >= 0.016666667) {
                timeline.advance(worlds, parts, meta, rules, width, height);
                let tick: int = timeline.playhead(meta);
                if (composer.grid(tick, clock[0])) {
                    slot = 0;
                    while (slot < 6) {
                        if (timeline.active(parts, slot, tick)) {
                            let before: float[] = timeline.snapshot(worlds, parts, meta, slot, tick - 1);
                            let now: float[] = timeline.snapshot(worlds, parts, meta, slot, tick);
                            let events: float[] = composer.events(before, now, tick, width, height, mix[slot], clock);
                            composer.remember(recent[slot], events, tick);
                            if (soundOn && arrangement.audible(parts, mix, slot, tick)) {
                                music.play(bank, events, slot, mix[slot], timeline.count(parts));
                            }
                        }
                        slot += 1;
                    }
                }
                accumulator -= 0.016666667;
            }
        } else { accumulator = 0.0; }

        if (frameLimit > 0 && forksmoke.verify(frame, worlds, parts, meta, rules, pending, mix, clock,
                                              selected, seed, paused, ghost, bank, soundOn, volume)) {
            music.close(bank); gfx.closeWindow(); return 1;
        }
        gfx.beginDrawing();
        view.render(worlds, parts, meta, mix, recent, pending, clock, selected, seed, scene, paused,
                    ghost, soundOn, bank.len() == 6, volume, dragging, mx, my);
        gfx.endDrawing();
        frame += 1;
        if (gfx.isKeyPressed(80) || (frameLimit > 0 && frame >= frameLimit)) {
            if (!gfx.takeScreenshot(screenshot)) { music.close(bank); gfx.closeWindow(); return 1; }
        }
        if (frameLimit > 0 && frame >= frameLimit) { break; }
    }
    music.close(bank); gfx.closeWindow(); return 0;
}
