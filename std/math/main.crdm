// Numeric helpers, written in Cardamom.

public fn abs(value: int) -> int {
    if (value < 0) {
        return 0 - value;
    }

    return value;
}

public fn min(a: int, b: int) -> int {
    if (a < b) {
        return a;
    }

    return b;
}

public fn max(a: int, b: int) -> int {
    if (a > b) {
        return a;
    }

    return b;
}

public fn pow(base: int, exponent: int) -> int {
    let result: int = 1;
    let i: int = 0;

    while (i < exponent) {
        result *= base;
        i += 1;
    }

    return result;
}

public fn sqrt(value: float) -> float {
    @include("<cmath>");
    @cpp("return std::sqrt(value);");
}
